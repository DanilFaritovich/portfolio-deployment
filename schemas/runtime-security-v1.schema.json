{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "portfolio.runtime/v1"
    },
    "readOnlyRootFilesystem": {
      "type": "boolean"
    },
    "user": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,4}:[1-9][0-9]{0,4}$"
    },
    "capDrop": {
      "const": [
        "ALL"
      ]
    },
    "noNewPrivileges": {
      "const": true
    },
    "restart": {
      "enum": [
        "no",
        "on-failure",
        "unless-stopped"
      ]
    },
    "imageHealthcheck": {
      "const": "preserve"
    },
    "tmpfs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "const": "/tmp"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1048576,
            "maximum": 268435456
          },
          "mode": {
            "const": "1777"
          }
        },
        "required": [
          "target",
          "sizeBytes",
          "mode"
        ]
      }
    }
  },
  "required": [
    "apiVersion",
    "readOnlyRootFilesystem",
    "user",
    "capDrop",
    "noNewPrivileges",
    "restart",
    "imageHealthcheck",
    "tmpfs"
  ]
}
